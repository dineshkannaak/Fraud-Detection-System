# API runtime
MODEL_DIR=models
MODEL_VERSION=xgboost-v1.0.0
PORT=8000

# Risk configuration
DECISION_THRESHOLD=0.50
LOW_RISK_THRESHOLD=0.30
HIGH_RISK_THRESHOLD=0.70

# Security: set a strong value in deployment; do not commit the real key
API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1000000
SYNC_THREAD_TOKENS=100
MAX_INFLIGHT_REQUESTS=100
PREDICTION_LOGGING=false

# Explainability
ENABLE_SHAP=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTER=false
MLFLOW_MODEL_NAME=fraud-detection-xgboost

# Optional verified artifact download
MODEL_ARTIFACT_URL=
MODEL_ARTIFACT_SHA256=
MODEL_ARTIFACT_TOKEN=

# Streamlit frontend
FRAUD_API_URL=http://localhost:8000
